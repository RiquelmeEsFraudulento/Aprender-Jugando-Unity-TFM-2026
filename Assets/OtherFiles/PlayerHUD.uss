/* ═══════════════════════════════════════════════════════════════════════════
   PlayerHUD.uss  v6 — PREMIUM UNIFIED PANEL
   ═══════════════════════════════════════════════════════════════════════════
   
   Layout:
   ┌─────────────────────────────────────────────────────┐
   │ ┌──┐ ┌──┐  ┌────┐┌────┐┌────┐┌────┐               │ ← top-row
   │ │L1│ │ ◯│  │ 🩸 ││ 🧪 ││ 💎 ││ ☯  │               │
   │ └──┘ └──┘  │  5 ││  3 ││  1 ││  0 │               │
   │            └────┘└────┘└────┘└────┘               │
   │ ████████████████████████████████████░░░░  HP      │ ← bars-stack
   │ ██████████████████████████░░░░░░░░░░░░  XP        │
   └─────────────────────────────────────────────────────┘
   
   ═══════════════════════════════════════════════════════════════════════════ */


/* ── ROOT ── */
.hud-root {
    position: absolute;
    top: 16px;
    left: 16px;
    flex-direction: column;
    align-items: flex-start;
}


/* ═══════════════════════════════════════════════════════════════
   UNIFIED PANEL — the single glass card
   ═══════════════════════════════════════════════════════════════ */
.hud-panel {
    flex-direction: column;
    align-items: stretch;
    background-color: rgba(10, 10, 18, 0.88);
    border-radius: 14px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.06);
    padding: 10px 12px 10px 10px;
    /* Premium border: subtle gradient-like double border effect */
    border-color: rgba(255, 255, 255, 0.08);
}


/* ═══════════════════════════════════════════════════════════════
   TOP ROW — Level + State + Items
   ═══════════════════════════════════════════════════════════════ */
.top-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}


/* ── Level badge ── */
.level-box {
    width: 42px;
    height: 42px;
    border-radius: 10px;
    justify-content: center;
    align-items: center;
    margin-right: 6px;
    background-color: rgba(22, 22, 32, 0.92);
    border-width: 1.5px;
    border-color: rgba(255, 255, 255, 0.1);
}

.level-label {
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    font-size: 16px;
    -unity-text-align: middle-center;
}


/* ── State circle ── */
.state-circle {
    width: 42px;
    height: 42px;
    border-radius: 21px;
    margin-right: 4px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.07);
}

.state-none     { background-color: rgba(45, 45, 58, 0.92); }
.state-sleep    { background-color: rgb(6, 6, 28); }
.state-confused { background-color: rgb(200, 200, 218); }


/* ── Thin vertical divider ── */
.controls-divider {
    width: 1px;
    height: 30px;
    background-color: rgba(255, 255, 255, 0.05);
    margin-left: 2px;
    margin-right: 4px;
}


/* ═══════════════════════════════════════════════════════════════
   ITEM SLOTS
   ═══════════════════════════════════════════════════════════════ */
.items-row {
    flex-direction: row;
    align-items: center;
}

.item-slot {
    width: 52px;
    height: 52px;
    border-radius: 10px;
    margin-left: 3px;
    margin-right: 3px;
    overflow: hidden;
    border-width: 1.5px;
    padding: 0;
    position: relative;
    transition-property: border-color, background-color, scale, opacity;
    transition-duration: 0.15s;
    /* Default border: nearly invisible */
    border-color: rgba(255, 255, 255, 0.04);
    background-color: rgba(16, 16, 24, 0.9);
}

/* ── Icon zone (top 66%) ── */
.item-icon {
    position: absolute;
    left: 5px;
    top: 3px;
    width: 42px;
    height: 30px;
    -unity-background-scale-mode: scale-to-fit;
}

/* ── Badge zone (bottom 34%) ── */
.item-counter {
    position: absolute;
    bottom: 1px;
    left: 0;
    right: 0;
    height: 14px;
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(200, 200, 210);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.8);
    padding: 0;
    letter-spacing: 0.3px;
}


/* Life Steal — red */
.slot-lifesteal .item-icon {
    background-image: url("project://database/Assets/OtherFiles/lifesteal.svg");
}

/* Potion — green */
.slot-potion .item-icon {
    background-image: url("project://database/Assets/OtherFiles/potion.svg");
}

/* Life Stone — blue */
.slot-lifestone .item-icon {
    background-image: url("project://database/Assets/OtherFiles/lifestone.svg");
}

/* Chaos — gold */
.slot-chaos .item-icon {
    background-image: url("project://database/Assets/OtherFiles/chaos.svg");
}

/* ═══════════════════════════════════════════════════════════════
   SLOT STATES
   ═══════════════════════════════════════════════════════════════ */

/* ── INACTIVE: clean, readable, no ugly overlay ── */
.slot-inactive {
    background-color: rgba(16, 16, 24, 0.9);
    border-color: rgba(255, 255, 255, 0.04);
}

.slot-inactive .item-icon {
    opacity: 0.5;
}

.slot-inactive .item-counter {
    color: rgb(120, 120, 135);
    text-shadow: none;
}


/* ── SELECTED: the one the player is pointing at ── */
.slot-selected {
    background-color: rgba(28, 28, 42, 0.95);
    border-color: rgba(255, 255, 255, 0.7);
    border-width: 2px;
    scale: 1.08;
}

.slot-selected .item-icon {
    opacity: 1.0;
}

.slot-selected .item-counter {
    color: rgb(255, 255, 255);
    text-shadow: 0 0 8px rgba(255, 255, 255, 0.25), 0 1px 2px rgba(0, 0, 0, 0.7);
}


/* ── ACTIVE: effect is running ── */
.slot-active .item-icon {
    opacity: 1.0;
}

.slot-active .item-counter {
    color: rgb(255, 225, 50);
    text-shadow: 0 0 10px rgba(255, 200, 30, 0.5), 0 1px 3px rgba(0, 0, 0, 0.9);
}


/* ── Life Steal: selected ── */
.slot-lifesteal.slot-selected {
    background-color: rgba(42, 10, 10, 0.93);
    border-color: rgb(240, 70, 70);
    border-width: 2px;
}

/* ── Life Steal: active ── */
.slot-lifesteal.slot-active {
    background-color: rgba(55, 10, 10, 0.94);
    border-color: rgb(225, 50, 50);
    border-width: 2px;
}


/* ── Potion: selected ── */
.slot-potion.slot-selected {
    background-color: rgba(10, 40, 14, 0.93);
    border-color: rgb(70, 220, 100);
    border-width: 2px;
}

/* ── Potion: active ── */
.slot-potion.slot-active {
    background-color: rgba(10, 50, 15, 0.94);
    border-color: rgb(50, 210, 80);
    border-width: 2px;
}


/* ── Life Stone: selected ── */
.slot-lifestone.slot-selected {
    background-color: rgba(12, 26, 52, 0.93);
    border-color: rgb(90, 160, 245);
    border-width: 2px;
}

/* ── Life Stone: active ── */
.slot-lifestone.slot-active {
    background-color: rgba(10, 28, 58, 0.94);
    border-color: rgb(65, 140, 235);
    border-width: 2px;
}

/* ── Life Stone: used this scene ── */
.slot-lifestone.slot-used {
    background-color: rgba(10, 10, 18, 0.9);
    border-color: rgba(35, 35, 55, 0.4);
    border-width: 1px;
}

.slot-lifestone.slot-used .item-icon {
    opacity: 0.2;
}

.slot-lifestone.slot-used .item-counter {
    color: rgb(45, 45, 65);
    text-shadow: none;
}


/* ── Chaos: selected ── */
.slot-chaos.slot-selected {
    background-color: rgba(38, 28, 6, 0.93);
    border-color: rgb(240, 190, 60);
    border-width: 2px;
}

/* ── Chaos: active ── */
.slot-chaos.slot-active {
    background-color: rgba(48, 34, 5, 0.94);
    border-color: rgb(225, 175, 35);
    border-width: 2px;
}


/* ═══════════════════════════════════════════════════════════════
   BARS STACK — sits inside the panel, below items
   ═══════════════════════════════════════════════════════════════ */
.bars-stack {
    flex-direction: column;
    align-items: stretch;
    margin-top: 2px;
}

.bar-container {
    background-color: rgba(14, 14, 22, 0.92);
    border-radius: 6px;
    overflow: hidden;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.05);
}

.bar-health {
    width: 100%;
    height: 28px;
    margin-bottom: 4px;
}

.bar-xp {
    width: 100%;
    height: 16px;
}

.bar-fill {
    height: 100%;
    width: 100%;
    border-radius: 5px;
}

.health-fill {
    background-color: rgb(195, 35, 35);
    border-right-width: 2px;
    border-right-color: rgba(255, 90, 90, 0.35);
}

.xp-fill {
    background-color: rgb(190, 145, 15);
    border-right-width: 2px;
    border-right-color: rgba(255, 205, 70, 0.3);
}


/* ═══════════════════════════════════════════════════════════════
   LOOT POPUP
   ═══════════════════════════════════════════════════════════════ */
.loot-popup {
    margin-top: 8px;
    margin-left: 2px;
    background-color: rgba(8, 8, 14, 0.93);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(255, 210, 70, 0.35);
    padding: 6px 14px;
    transition-property: opacity;
    transition-duration: 0.35s;
}

.loot-hidden {
    opacity: 0;
    display: none;
}

.loot-visible {
    opacity: 1;
    display: flex;
}

.loot-label {
    color: rgb(255, 215, 75);
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    text-shadow: 0 0 12px rgba(255, 200, 60, 0.35), 0 1px 3px rgba(0, 0, 0, 0.9);
}
